{
  "name": "datendetektei",
  "version": "0.7.0",
  "private": true,
  "description": "Datendetektei Weserstedt – Ermitteln mit Datenbanken (Plattform im Verbund InfoLabs)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js",
    "vertrag": "node scripts/vertrag_pruefen.js http://localhost:3000",
    "fonts": "node scripts/fonts_kopieren.js",
    "kontrast": "node scripts/kontrast_pruefen.js",
    "db": "node scripts/db_bauen.js",
    "db:pruefen": "node scripts/db_bauen.js --pruefen",
    "db:video": "node -e \"process.exitCode = require('./scripts/db_bauen').lauf({ reihenfolge: ['video/schachturnier'] })\"",
    "db:video:pruefen": "node -e \"process.exitCode = require('./scripts/db_bauen').lauf({ reihenfolge: ['video/schachturnier'], pruefen: true })\"",
    "sqljs": "node scripts/sqljs_kopieren.js",
    "e2e": "node --test test/e2e/*.e2e.js",
    "validate": "node scripts/validate.js",
    "arbeitsblaetter": "python3 werkzeuge/arbeitsblaetter_pdf.py",
    "loesungen": "python3 werkzeuge/loesungen_pdf.py",
    "lehrkraft": "python3 werkzeuge/lehrkraft_pdf.py",
    "praesentationen": "python3 werkzeuge/praesentationen_pdf.py",
    "originale": "python3 werkzeuge/originale_verzeichnis.py",
    "material:pdf": "npm run arbeitsblaetter && npm run loesungen && npm run praesentationen && npm run lehrkraft && npm run originale",
    "material:vollstaendig": "python3 werkzeuge/arbeitsblaetter_pdf.py --pruefen && python3 werkzeuge/loesungen_pdf.py --pruefen && python3 werkzeuge/praesentationen_pdf.py --pruefen && python3 werkzeuge/lehrkraft_pdf.py --pruefen && python3 werkzeuge/originale_verzeichnis.py --pruefen && python3 werkzeuge/video_folien.py --pruefen",
    "material:sql": "python3 werkzeuge/material_sql_pruefen.py",
    "material:pruefen": "python3 werkzeuge/materialien_pruefen.py",
    "material:kompetenzen": "python3 werkzeuge/kompetenz_abdeckung.py --streng",
    "videos": "python3 werkzeuge/video_folien.py",
    "videos:bilder": "python3 werkzeuge/video_folien.py --bilder",
    "videos:pruefen": "python3 werkzeuge/video_folien.py --pruefen",
    "material:tests": "python3 -m unittest discover -s werkzeuge/tests",
    "pruefen": "npm test && npm run validate && npm run material:tests && npm run material:vollstaendig && npm run material:sql && npm run material:pruefen && npm run material:kompetenzen"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "playwright-core": "1.56.1",
    "sql.js": "1.14.2",
    "supertest": "^7.3.1"
  }
}
