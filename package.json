{
  "name": "datendetektei",
  "version": "0.2.0",
  "private": true,
  "description": "Datendetektei Weserstedt – Ermitteln mit Datenbanken (Plattform im Verbund InfoLabs)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js",
    "vertrag": "node scripts/vertrag_pruefen.js http://localhost:3000",
    "fonts": "node scripts/fonts_kopieren.js",
    "kontrast": "node scripts/kontrast_pruefen.js",
    "db": "node scripts/db_bauen.js",
    "db:pruefen": "node scripts/db_bauen.js --pruefen",
    "sqljs": "node scripts/sqljs_kopieren.js",
    "e2e": "node --test test/e2e/*.e2e.js",
    "validate": "node scripts/validate.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "playwright-core": "1.56.1",
    "sql.js": "1.14.2",
    "supertest": "^7.3.1"
  }
}
