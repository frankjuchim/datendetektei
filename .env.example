# Umgebungsvariablen nach Vertrag §8 (Werte für den Betrieb; in CapRover unter „App Configs“ eintragen).
PLATTFORM_ID=datendetektei
PLATTFORM_URL=https://datendetektei.frankjuchim.de
PORTAL_URL=https://labs.frankjuchim.de
# Inhalt von https://labs.frankjuchim.de/sso/schluessel.pem – einzeilig mit \n erlaubt, mehrere PEM-Blöcke erlaubt
PORTAL_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
AUTH_MODUS=portal
# zufällig, mindestens 32 Zeichen, z. B. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
DATA_DIR=/app/data
PORT=80
TRUST_PROXY=1
